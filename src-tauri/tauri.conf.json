{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mardow",
  "version": "0.2.2",
  "identifier": "local.mardow.tauri",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/": "dist/"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt",
          "json"
        ],
        "contentTypes": [
          "public.text",
          "public.json",
          "net.daringfireball.markdown"
        ],
        "name": "Text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBQ0NFM0ZDMkRGODlGQ0MKUldUTW4vZ3QvT1BNQ3RzNjRmdlRqcE1hNTU2WmdvT0NUbUlKUFNQcVZOdlpMRFpyajN3ZUxzQjIK",
      "endpoints": [
        "https://github.com/moinahoi/mardow/releases/latest/download/latest.json"
      ]
    }
  }
}
