{
  "name": "mardow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "web": "vite build && PATH=$HOME/.cargo/bin:$PATH cargo run --release --manifest-path src-tauri/Cargo.toml -- --web",
    "dev": "vite",
    "server": "PATH=$HOME/.cargo/bin:$PATH cargo run --manifest-path src-tauri/Cargo.toml -- --web",
    "desktop": "PATH=$HOME/.cargo/bin:$PATH tauri dev",
    "dist": "PATH=$HOME/.cargo/bin:$PATH tauri build",
    "test": "PATH=$HOME/.cargo/bin:$PATH cargo test --manifest-path src-tauri/Cargo.toml && node src/board.test.js && node src/plaintext.test.js",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0"
  }
}
